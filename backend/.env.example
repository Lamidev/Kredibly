# Application Settings
PORT=7050
NODE_ENV=development
JWT_SECRET=your_secure_jwt_secret_here

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:7050

# Database
MONGODB_URL=mongodb://username:password@cluster.mongodb.net/dbname

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=hello@usekredibly.com
ADMIN_EMAIL=usekredibly@gmail.com

# AI (Google Gemini)
KREDDY_API_KEY=your_gemini_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# WhatsApp (Meta)
WHATSAPP_BUSINESS_ID=your_whatsapp_business_id
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_PHONE_NUMBER=your_whatsapp_phone_number

# Nomba (Payment Provider)
NOMBA_ENV=development
NOMBA_ACCOUNT_ID=your_nomba_account_id
NOMBA_CLIENT_ID=your_nomba_client_id
NOMBA_PRIVATE_KEY=your_nomba_private_key
NOMBA_WEBHOOK_SECRET=your_nomba_webhook_secret

# Sentry
SENTRY_DSN=your_sentry_dsn
